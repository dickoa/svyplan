frame <- data.frame(
  N    = c(4000, 3000, 3000),
  sd   = c(10, 15, 8),
  mean = c(50, 60, 55)
)
alloc <- n_alloc(frame, n = 600)
predict(alloc, data.frame(n = seq(200, 1000, 200)))

# Two-stage joint allocation: what does the per-PSU take cost?
cluster_frame <- data.frame(
  stratum  = c("Urban", "Rural"),
  N        = c(60000, 40000),
  N_psu    = c(600, 500),
  n_per_psu = c(10, 10),
  cost_psu = c(400, 550),
  cost_ssu = c(20, 25)
)
